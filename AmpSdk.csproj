<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Amp.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>AMP SDK — Avalanche Tournament &amp; Match Protocol: on-chain prize pools, EIP-712 attestations, pull-payment claims, and ranked matchmaking on Avalanche. Works with Unity, Godot, and .NET.</Description>
    <PackageTags>amp;tournament;avalanche;matchmaking;prize-pool;escrow;web3;glicko;eip712;unity;godot;dotnet</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BradMyrick/amp-sdk-csharp</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nethereum.Web3" Version="4.26.0" />
    <PackageReference Include="Nethereum.Signer" Version="4.26.0" />
    <PackageReference Include="Nethereum.Signer.EIP712" Version="4.26.0" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
    <None Include="examples/**/*.cs" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>
</Project>
